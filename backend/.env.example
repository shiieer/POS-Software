SECRET_KEY=change-me-to-a-long-random-string
# Use the Supabase Postgres connection URI to store orders and tables in Supabase.
# Keep SQLite for local development if preferred.
DATABASE_URL=sqlite:///./data/pos.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Development fallback. Local and private-network hosts are replaced with the
# current browser hostname when table QR codes are generated.
CUSTOMER_WEB_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_MENU_BUCKET=menu_images
SUPABASE_QR_BUCKET=qr_codes
SUPABASE_QRIS_BUCKET=qris
SUPABASE_PAYMENT_PROOF_BUCKET=payment-proofs
SUPABASE_AVATARS_BUCKET=avatars
